# Runtime (server) — set these in your hosting environment.
# Endpoint the contact form proxies leads to (your CRM / backend).
PLATFORM_LEADS_URL=https://your-backend.example.com/api/leads
# Cloudflare Turnstile secret key (server-side verification).
TURNSTILE_SECRET_KEY=

# Build-time (inlined at build → declare as a Build Variable).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
